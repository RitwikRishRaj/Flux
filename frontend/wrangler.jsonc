{
  "name": "flux",
  "main": "./party/server.ts",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "Main", "class_name": "FluxRoom" },
      { "name": "LIMITER", "class_name": "Limiter" }
    ]
  },
  // Legacy migration syntax for now; step 4b moves to "exports" before the first deploy.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["FluxRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["Limiter"] }
  ],
  "vars": { "DAILY_RUN_BUDGET": "3000" }
}
