// One Worker: serves the static site (out/, from `next build`) and hosts the rooms and the Limiter.
// Secrets are never here: ONLINECOMPILER_API_KEY and TURNSTILE_SECRET_KEY go in .dev.vars locally and
// `npx wrangler secret put <NAME> --env production` for production.
{
  "name": "flux",
  "main": "./party/server.ts",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only these reach the Worker; every other request is a static file (free, not a Worker request).
    "run_worker_first": ["/parties/*", "/status", "/room/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "Main", "class_name": "FluxRoom" },
      { "name": "LIMITER", "class_name": "Limiter" }
    ]
  },
  "exports": {
    "FluxRoom": { "type": "durable-object", "storage": "sqlite" },
    "Limiter": { "type": "durable-object", "storage": "sqlite" }
  },
  // Local dev (`npm run wrangler`, `npm run preview`).
  "vars": {
    "DAILY_RUN_BUDGET": "3000",
    "ROOM_IDLE_MINUTES": "2",
    "ALLOWED_ORIGINS": "http://localhost:3000,http://127.0.0.1:3000,http://localhost:8787,http://127.0.0.1:8787"
  },
  "env": {
    // `npm run deploy` (= wrangler deploy --env production). Bindings and vars aren't inherited, so they are repeated.
    "production": {
      "durable_objects": {
        "bindings": [
          { "name": "Main", "class_name": "FluxRoom" },
          { "name": "LIMITER", "class_name": "Limiter" }
        ]
      },
      "vars": {
        "DAILY_RUN_BUDGET": "3000",
        "ROOM_IDLE_MINUTES": "2",
        // Replace with your site's origin(s), comma-separated, e.g. "https://flux.example.com".
        "ALLOWED_ORIGINS": "https://flux.example.com"
      },
      "secrets": { "required": ["ONLINECOMPILER_API_KEY", "TURNSTILE_SECRET_KEY"] }
    }
  }
}
