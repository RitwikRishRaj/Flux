# Sync server URL: `npm run wrangler` (wrangler dev) listens on 8787 by default
NEXT_PUBLIC_PARTYKIT_URL=http://127.0.0.1:8787
# Turnstile site key (public). This is Cloudflare's test key that always passes, invisibly; use your own in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000BB
